{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "dist-ssr",
    "coverage",
    "playwright-report",
    "test-results",
    "node_modules",
    "src-tauri/target",
    "src-tauri/gen",
    "src-tauri/icons",
    "**/*.toml",
    "pnpm-lock.yaml",
    ".claude",
    "src-tauri/tests/fixtures",
    "scripts/__fixtures__",
    "src-tauri/**/snapshots",
    "*.snap",
    ".impeccable",
    "DESIGN.md",
    "src/data/supported-sites.json",
    "website/**/*.astro",
    "website/.astro",
    "website/.screens",
    "website/public/diagramas/**/*.html",
    "website/public/google*.html"
  ]
}
