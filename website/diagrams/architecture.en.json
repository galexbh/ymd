  "cards": [
    {
      "dot": "cyan",
      "title": "IPC contract",
      "items": [
        "model.rs is the source of truth for the types",
        "src/ipc/commands.ts is the only place that calls invoke",
        "Events carry each download's progress to the interface"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets",
      "items": [
        "Passwords live only in the keychain; yt-dlp asks via --netrc-cmd",
        "cookies.txt is owner-only",
        "yt-dlp downloads from the sites over HTTPS"
      ]
    },
    {
      "dot": "emerald",
      "title": "Updates",
      "items": [
        "Tools are verified with SHA-256 and swapped atomically",
        "ymd updates from a signed latest.json (minisign)",
        "The queue never swaps yt-dlp while downloads run"
      ]
    }
  ]
