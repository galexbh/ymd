  "cards": [
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Native Messaging: no network ports, no server",
        "Only the fixed extension ID is accepted as origin",
        "Neither the log nor the stored status keeps cookie values"
      ]
    },
    {
      "dot": "cyan",
      "title": "One process per message",
      "items": [
        "The browser launches ymd.exe for every send",
        "It reads one frame, replies and exits",
        "Unreadable frame: error reply and exit code 1"
      ]
    },
    {
      "dot": "amber",
      "title": "When something fails",
      "items": [
        "Reply {ok:false, code, detail}",
        "With no valid cookies the previous cookies.txt is kept",
        "The popup shows the error"
      ]
    }
  ]
